# Default starter mode. Use a strong value (16+ characters recommended).
EVE_CHAT_PASSWORD=

# Optional production mode. Configure every value in this section to switch
# from browser storage/password auth to Neon, Upstash, and Sign in with Vercel.
DATABASE_URL=
BETTER_AUTH_SECRET=
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: long-term memory in a private Vercel Blob store (any mode).
# Set by `pnpm exec eve integration setup file-memory`. Memory stays disabled on
# Vercel until one of these is present; generic BLOB_* variables are ignored.
EVE_MEMORY_BLOB_STORE_ID=
EVE_MEMORY_BLOB_WEBHOOK_PUBLIC_KEY=

# Optional: override the app origin for a custom production domain.
BETTER_AUTH_URL=

# Optional: enable hosted Vercel Connect integrations.
SLACK_CONNECTOR=
LINEAR_CONNECTOR=
NOTION_CONNECTOR=
SENTRY_CONNECTOR=

# Tomok project evidence and reviewed memory (independent of chat persistence).
# Configure these in both the web and eve service environments.
MONGODB_URI=
MONGODB_DATABASE=
# Comma-separated authenticated user IDs allowed to access the fixed project.
# Required in Sign in with Vercel mode; password/local mode has one operator.
TOMOK_PROJECT_VIEWER_IDS=
